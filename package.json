{
  "name": "kitchen-cad",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "cf:types": "wrangler types",
    "sync:init": "node server/init.mjs",
    "sync:server": "node --no-warnings --env-file-if-exists=.env.local server/index.mjs",
    "sync:agent": "node --no-warnings --env-file-if-exists=.env.local server/agent.mjs",
    "sync:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-sync-startup.ps1",
    "sync:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/uninstall-sync-startup.ps1"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.0",
    "@react-three/fiber": "^9.3.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260918.1",
    "@types/node": "^26.6.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^5.0.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "wrangler": "^4.134.0"
  }
}
