# Copy to .env.local or run: npm run sync:init
KITCHEN_CAD_SYNC_TOKEN=replace-with-at-least-32-random-characters
KITCHEN_CAD_SYNC_HOST=127.0.0.1
KITCHEN_CAD_SYNC_PORT=8787
KITCHEN_CAD_ALLOWED_ORIGINS=https://kitchen-cad.pages.dev,https://den-2020.github.io,http://localhost:5173,http://127.0.0.1:5173

# Optional. The default on Windows is %LOCALAPPDATA%\KitchenCAD.
# KITCHEN_CAD_DATA_DIR=C:\Users\Admin\AppData\Local\KitchenCAD
